  "narrative": {
    "northStar": "Le direct derrière le verre",
    "overview": "Ce nom décrit la direction réalisée ; il ne constitue pas une préférence supplémentaire attribuée à l’utilisateur. Les demandes confirmées sont une application mobile, un design moderne, du glassmorphisme et un menu flottant. Le nom FLUX, la langue française et la palette sont les choix de conception de cette livraison.\n\nLe système place les images de diffusion sur un fond sombre, avec des commandes arrondies et une navigation de verre. L’accent menthe identifie les actions principales et la destination sélectionnée. Les informations de direct utilisent un accent distinct pour conserver une hiérarchie lisible. La révision V2 répond à la correction de l’utilisateur sur l’opacité excessive des panneaux : 83 surfaces de verre ont été rendues plus transparentes, avec des reflets en dégradé et une ombre douce.",
    "keyCharacteristics": [
      "Fond sombre et contenu vidéo au premier plan.",
      "Navigation flottante à quatre destinations.",
      "Verre transparent en dégradé, reflets fins et ombre douce.",
      "Accent menthe pour les actions principales."
    ],
    "rules": [
      {
        "name": "The Badge Contrast Rule",
        "body": "Conserver le rouge de badge sous le texte blanc du direct ; ne pas le remplacer automatiquement par le corail de la palette.",
        "section": "colors"
      },
      {
        "name": "The Glass Readability Rule",
        "body": "Maintenir une surface protectrice derrière les commandes qui chevauchent une image de diffusion.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** conserver la hiérarchie fond sombre, contenu vidéo, commandes de verre et accent menthe.",
      "**Do** réutiliser les trois composants natifs pour les nouvelles compositions compatibles.",
      "**Do** protéger les commandes superposées aux images avec un fond lisible.",
      "**Do** distinguer les tokens observés des conseils d’implémentation."
    ],
    "donts": [
      "**Don't** présenter les cadres statiques comme un prototype fonctionnel ou une application testée.",
      "**Don't** convertir les dimensions de canevas en promesse de comportement responsive.",
      "**Don't** confondre le corail de palette avec le rouge du badge de direct.",
      "**Don't** présenter les aperçus HTML ou les rampes synthétiques comme des composants natifs supplémentaires."
    ]
  }
}
